<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Redirection HTTPS
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Transmission du header Authorization à PHP-FPM
  RewriteCond %{HTTP:Authorization} ^(.*)
  RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

  # 3. Délégation API via le lien symbolique "api"
  RewriteCond %{REQUEST_URI} ^/api(/.*)?$
  RewriteRule ^api/?(.*)$ api/index.php [QSA,L]

  # 4. Fallback SPA (uniquement si la requête ne commence PAS par /api)
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_URI} !^/api
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
  DirectoryIndex index.html
</IfModule>

# Mise en cache et sécurité
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"

  <FilesMatch "\.(js|css|webp|png|jpg|jpeg|gif|svg|woff|woff2)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  <FilesMatch "index\.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>