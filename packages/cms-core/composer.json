{
    "name": "fagathe/cms-core",
    "description": "Core SEO library for CMS Validation and Front-end generation",
    "type": "library",
    "repositories": [
        {
        "type": "vcs",
        "url": "git@github.com:fagathe-dev/core-php.git"
        }
    ],
    "require": {
        "php": ">=8.1",
        "symfony/validator": "^8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/routing": "^8.1",
        "fagathe-dev/core-php": ">=1.1.3",
        "symfony/serializer": "^8.1",
        "phpstan/phpdoc-parser": "^2.0",
        "phpdocumentor/type-resolver": "^1.10 || ^2.0",
        "symfony/http-kernel": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "beberlei/doctrineextensions": "^1.5",
        "symfony/security-bundle": "^8.1",
        "symfony/security-core": "^8.1",
        "symfony/security-http": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/translation": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Fagathe\\CmsCore\\": "src/"
        }
    },
    "extra": {
        "symfony": {
            "bundle": "Fagathe\\CmsCore\\CmsCoreBundle"
        }
    }
}
